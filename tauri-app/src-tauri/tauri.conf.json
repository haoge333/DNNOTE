{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "龙之谷小助手",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "fs": { "all": false, "readFile": true, "writeFile": true },
      "dialog": { "all": false, "open": true, "save": true },
      "path": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": "nsis",
      "identifier": "com.dn.helper",
      "icon": ["icons/icon.ico"]
    },
    "security": { "csp": null },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "龙之谷小助手",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  }
}
